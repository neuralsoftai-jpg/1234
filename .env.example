# Password that visitors type to connect to the owner
SPECIAL_PASSWORD=your_special_password_here

# Secret key that the owner uses at /owner to log in
OWNER_KEY=your_owner_key_here

# Port (optional, defaults to 3000)
PORT=3000

# Vercel frontend setting. Point this to the deployed Socket.IO backend.
# Example: https://chatroom-api.onrender.com
VITE_API_URL=https://your-websocket-backend.example.com

# Required on Vercel and on production Render/Railway deployments.
# Local development generates and persists .vapid.json when omitted.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Do NOT commit .vapid.json — it is in .gitignore.
# Do NOT commit .env — it is in .gitignore.
