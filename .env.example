# Password that visitors type to connect to the owner
SPECIAL_PASSWORD=your_special_password_here

# Secret key that the owner uses at /owner to log in
OWNER_KEY=your_owner_key_here

# Port (optional, defaults to 3000)
PORT=3000

# Note: VAPID keys are auto-generated into .vapid.json on first run.
# Do NOT commit .vapid.json — it is in .gitignore.
# Do NOT commit .env — it is in .gitignore.
